# ============ Supabase ============
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============ App ============
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret protecting the Vercel Cron drip endpoint (send as ?secret= or Bearer)
CRON_SECRET=change-me-to-a-long-random-string
# Salt mixed into anonymous ballot vote hashes — set once, never change
BALLOT_SALT=change-me-to-a-long-random-string

# ============ M-Pesa Daraja API ============
# MODE: stub (default, logs only) | sandbox | live
MPESA_MODE=stub
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# B2C queue timeout / result URLs (public URLs of this app)
MPESA_CALLBACK_URL=https://your-app.vercel.app/api/mpesa/callback
MPESA_B2C_RESULT_URL=https://your-app.vercel.app/api/mpesa/b2c-callback
MPESA_B2C_TIMEOUT_URL=https://your-app.vercel.app/api/mpesa/b2c-callback

# ============ SMS (Africa's Talking) ============
# PROVIDER: stub (default, logs only) | africastalking
SMS_PROVIDER=stub
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=
